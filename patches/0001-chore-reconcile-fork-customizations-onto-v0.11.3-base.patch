++                    or decoded.get("ad_groups")
++                    or decoded.get("roles")
++                    or decoded.get("wids")
++                ),
++            )
++
++            claims_dict = asdict(claims)
++            if any(v is not None for v in claims_dict.values()):
++                return {k: v for k, v in claims_dict.items() if v is not None}
++
