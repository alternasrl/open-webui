+@requires_ml
+def test_noise_detection():
+    from open_webui.prompt_insights.clusterer import cluster_embeddings
+
+    labels, noise = cluster_embeddings([[0, 0], [0.1, 0], [0, 0.1], [9, 9]], min_cluster_size=2)
