++                algorithms=['RS256', 'HS256', 'ES256'],
++            )
++
++            claims = OIDCClaims(
++                sub=decoded.get('sub'),
++                auth_time=decoded.get('auth_time'),
++                amr=decoded.get('amr'),
++                acr=decoded.get('acr'),
++                ad_groups=(
++                    decoded.get('groups') or decoded.get('ad_groups') or decoded.get('roles') or decoded.get('wids')
