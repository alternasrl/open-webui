++            log_scheduled_activity,
++            "TASK_AUTOMATION_SCHEDULED",
++            "dave@example.com", "admin",
++            "auto-uuid-77", "automation",
++            200, 2.0,
++        )
++        msg = record.getMessage()
++        assert "/api/v1/automations/auto-uuid-77/run" in msg
