+-        try:
+-            # Metodo 1: request.state.user (dopo autenticazione)
+-            if hasattr(request.state, "user") and request.state.user:
+-                user = request.state.user
+-                if isinstance(user, dict):
+-                    # PRIORITÀ: email > username > id
+-                    email = user.get("email")
