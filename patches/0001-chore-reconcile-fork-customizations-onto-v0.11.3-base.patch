+    cluster, trends = await PromptInsightsTable.get_trend_for_cluster(cluster_id=cluster_id, db=db)
+    if cluster is None:
+        raise HTTPException(status_code=404, detail='Cluster not found')
+
+    return PromptClusterTrendResponse(
