+        (rf'^/api/v1/auths/add$', 'POST', 'USER_CREATE'),
+        # ── User Management ──────────────────────────────────────────────
+        (rf'^/api/v1/users/default/permissions$', 'POST', 'USER_PERMISSIONS_DEFAULT'),
+        (rf'^/api/v1/users/{_ID}/update$', 'POST', 'USER_UPDATE'),
