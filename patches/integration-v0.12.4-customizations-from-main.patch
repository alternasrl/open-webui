+        issue['route'] == ('GET', '/api/v1/files/{id}/content') for issue in build_report()['mutating_generic_issues']
+    )
+
+
+@pytest.mark.parametrize(
+    ('method', 'path', 'action'), [(method, path, action) for (method, path), action in REQUIRED_ACTIONS.items()]
+)
