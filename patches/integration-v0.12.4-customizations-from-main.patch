+
+@pytest.fixture
+def audit_file(tmp_path):
+    import importlib
+
+    from loguru import logger
+    from open_webui.utils.logger import file_format
+
+    importlib.import_module('open_webui.main')
+    path = tmp_path / 'audit.jsonl'
