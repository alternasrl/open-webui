-												updateOpenAIHandler();
-											}}
+											onSubmit={() => updateOpenAIHandler()}
 											onDelete={() => {
 												OPENAI_API_BASE_URLS = OPENAI_API_BASE_URLS.filter(
 													(url, urlIdx) => idx !== urlIdx
@@ -329,9 +335,7 @@
 											bind:url={OLLAMA_BASE_URLS[idx]}
