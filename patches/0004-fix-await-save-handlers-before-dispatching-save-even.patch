@@ -195,10 +199,14 @@
 	});
 
 	const submitHandler = async () => {
-		updateOpenAIHandler();
-		updateOllamaHandler();
+		const [openaiOk, ollamaOk] = await Promise.all([
+			updateOpenAIHandler(),
+			updateOllamaHandler()
+		]);
 
-		dispatch('save');
+		if (openaiOk || ollamaOk) {
+			dispatch('save');
+		}
 
 		await config.set(await getBackendConfig());
 	};
@@ -265,9 +273,7 @@
 											bind:key={OPENAI_API_KEYS[idx]}
