+_CACHE_MAX = 2048
+_CACHE_TTL = 300  # seconds
+_CACHE_TTL_SHORT = 10  # seconds — for entries missing OIDC claims (login race)
+_cache_lock = threading.Lock()
+_cache_data: dict[str, tuple[_UserContext, float]] = {}  # user_id → (ctx, ts)
